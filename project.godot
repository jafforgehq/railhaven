; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Railhaven"
config/use_custom_user_dir=true
config/custom_user_dir_name="Railhaven"
config/description="Idle colony management aboard a moving armored train."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/app_icon.png"
run/max_fps=60
config/quit_on_go_back=false

[autoload]

Game="*res://scripts/autoloads/game.gd"
Audio="*res://scripts/autoloads/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

common/snap_controls_to_pixels=true
theme/custom_font="res://assets/fonts/BarlowCondensed-SemiBold.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_2d=2
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.075, 0.085, 1)
